{{!
    @template local_course_access/option_row

    A single editable option row (display name + technical value).
    Rendered server-side for existing options and client-side by the
    configure_form AMD module when the teacher adds a new option.

    Context variables required:
    * index - unique integer index for the form field names
    * id - existing option id (empty for new)
    * name - display name
    * value - technical value (used in access restrictions)

    Example context (json):
    {
        "index": 0,
        "id": 12,
        "name": "Mañana",
        "value": "turno_manana"
    }
}}
<div class="lcc-option-row d-flex gap-2 mb-2 align-items-start" data-option-index="{{index}}">
    <input type="hidden" name="condition[options][{{index}}][id]" value="{{id}}">
    <div class="flex-fill">
        <input type="text"
               class="form-control lcc-option-name"
               name="condition[options][{{index}}][name]"
               value="{{name}}"
               placeholder="{{#str}}optionname_placeholder, local_course_access{{/str}}"
               aria-label="{{#str}}optionname, local_course_access{{/str}}"
               required>
    </div>
    <div class="flex-fill">
        <input type="text"
               class="form-control lcc-option-value"
               name="condition[options][{{index}}][value]"
               value="{{value}}"
               placeholder="{{#str}}optionvalue_placeholder, local_course_access{{/str}}"
               aria-label="{{#str}}optionvalue, local_course_access{{/str}}"
               data-manual="{{#value}}1{{/value}}{{^value}}0{{/value}}"
               required>
    </div>
    <button type="button"
            class="btn btn-outline-danger lcc-remove-option"
            aria-label="{{#str}}removeoption, local_course_access{{/str}}">
        <i class="fa fa-trash" aria-hidden="true"></i>
    </button>
</div>
