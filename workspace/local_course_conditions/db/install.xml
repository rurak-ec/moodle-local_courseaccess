<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/course_conditions/db" VERSION="20250125" COMMENT="XMLDB file for Course Conditionals plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>

    <!-- ========================================= -->
    <!-- CONDITIONS (Condiciones del Curso) -->
    <!-- ========================================= -->

    <TABLE NAME="local_course_conditions_conditions" COMMENT="Course specific conditions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Condition name (e.g. Turno, Grupo)"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Description"/>
        <FIELD NAME="custom_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Custom identifier for profile field (defaults to courseid)"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Whether condition is active (1) or disabled (0)"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="sortorder_idx" UNIQUE="false" FIELDS="sortorder"/>
      </INDEXES>
    </TABLE>

    <!-- ========================================= -->
    <!-- OPTIONS (Opciones de cada Condición) -->
    <!-- ========================================= -->

    <TABLE NAME="local_course_conditions_options" COMMENT="Available options for each condition">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="conditionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Condition ID"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Option name"/>
        <FIELD NAME="value" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Technical value/code"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="conditionid" TYPE="foreign" FIELDS="conditionid" REFTABLE="local_course_conditions_conditions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="conditionid_idx" UNIQUE="false" FIELDS="conditionid"/>
      </INDEXES>
    </TABLE>

    <!-- ========================================= -->
    <!-- USER SELECTIONS (Selecciones de Usuarios) -->
    <!-- ========================================= -->

    <TABLE NAME="local_course_conditions_selections" COMMENT="User selections per condition">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="conditionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Condition ID"/>
        <FIELD NAME="optionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Selected option ID"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="conditionid" TYPE="foreign" FIELDS="conditionid" REFTABLE="local_course_conditions_conditions" REFFIELDS="id"/>
        <KEY NAME="optionid" TYPE="foreign" FIELDS="optionid" REFTABLE="local_course_conditions_options" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid_idx" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="user_condition_idx" UNIQUE="true" FIELDS="userid,conditionid"/>
      </INDEXES>
    </TABLE>

    <!-- ========================================= -->
    <!-- CHANGE HISTORY (Historial de Cambios) -->
    <!-- ========================================= -->

    <TABLE NAME="local_course_conditions_history" COMMENT="History of selection changes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who changed"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="conditionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Condition ID"/>
        <FIELD NAME="old_optionid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Previous option"/>
        <FIELD NAME="new_optionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="New option"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Reason"/>
        <FIELD NAME="changed_by" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who made the change"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="conditionid" TYPE="foreign" FIELDS="conditionid" REFTABLE="local_course_conditions_conditions" REFFIELDS="id"/>
        <KEY NAME="changed_by" TYPE="foreign" FIELDS="changed_by" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid_courseid_idx" UNIQUE="false" FIELDS="userid,courseid"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
